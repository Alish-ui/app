        </LinearLayout>
 <!-- More CP Step Blocks (copy/paste as needed) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@android:color/white"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvStepTitle1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CP Step 2: Something Else"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/tvStepDescription1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Some description for step 2..."
                android:textSize="14sp"
                android:textColor="#444444"
                android:layout_marginTop="4dp"/>

            <ImageView
                android:id="@+id/ivStepImage1"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:layout_marginTop="8dp"
                android:src="@drawable/img"/>
        </LinearLayout>

        <!-- Add more step sections as needed -->



    </LinearLayout>
</ScrollView>
