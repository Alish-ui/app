<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/img_24"/>

    <EditText
        android:id="@+id/edtSearchVisitor"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="Search visitors..."/>

    <Spinner
        android:id="@+id/spinnerSortVisitor"
        android:layout_width="match_parent"
        android:layout_height="45dp"/>
    <Switch
        android:id="@+id/switchAnonymousMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Anonymous Mode"
        android:layout_marginTop="10dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewVisitors"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
