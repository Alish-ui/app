<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical">

    <!-- Profile Image -->
    <ImageView
        android:id="@+id/imgProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/img"
        android:scaleType="centerCrop"
        android:layout_marginEnd="8dp"
        android:background="@drawable/circle_background"/>

    <!-- Visitor Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtVisitorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visitor Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>

        <TextView
            android:id="@+id/txtLastSeen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last seen 5 min ago"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"/>
    </LinearLayout>

    <!-- Country Flag -->
    <ImageView
        android:id="@+id/imgCountryFlag"
        android:layout_width="24dp"
        android:layout_height="16dp"
        android:src="@drawable/flag_singapore"
        android:layout_marginEnd="8dp"/>

    <!-- Status Indicator -->
    <View
        android:id="@+id/statusIndicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/circle_background"
        android:layout_marginEnd="8dp"/>

    <!-- Top Visitor Badge -->
    <ImageView
        android:id="@+id/imgTopVisitor"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/img"
        android:visibility="gone"
        android:layout_marginEnd="8dp"/>

    <!-- Gift Sender Badge -->
    <ImageView
        android:id="@+id/imgGiftSender"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/img_28"
        android:visibility="gone"/>
</LinearLayout>
