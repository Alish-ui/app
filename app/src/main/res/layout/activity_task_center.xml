<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E5FCFF"
    android:padding="16dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#A0EBFF"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/img_4"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Task Center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <!-- Check-in Section -->
    <Button
        android:id="@+id/btnCheckIn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Check-in"
        android:textSize="12sp"
        android:textColor="#FFF"
        android:background="@drawable/bg_button_blue"
        android:padding="8dp"
        android:layout_gravity="start"
        android:layout_marginTop="8dp"/>

    <!-- Check-in Calendar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_rounded">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check-in Calendar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCheckInCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- Check-in Reminder -->
    <CheckBox
        android:id="@+id/cbCheckInReminder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Check-in reminder"
        android:textSize="14sp"
        android:layout_marginTop="12dp"/>

    <!-- Check-in Button -->
    <Button
        android:id="@+id/btnCheckInMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Check-in"
        android:textSize="16sp"
        android:background="@drawable/bg_button_blue"
        android:textColor="#FFF"
        android:padding="12dp"
        android:layout_marginTop="8dp"/>

    <!-- Extra Bonus Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#A0EBFF"
        android:padding="12dp"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Extra Bonus"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000"/>

        <TextView
            android:id="@+id/tvCheckInDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You have checked in continuously for 1 day"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

        <SeekBar
            android:id="@+id/sbBonusProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="15"
            android:progress="1"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#A0EBFF"
        android:padding="12dp"
        android:gravity="center">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/img_4"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/img_4"
            android:layout_marginStart="16dp"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/img_4"
            android:layout_marginStart="16dp"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/img_49"
            android:layout_marginStart="16dp"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/img_4"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

</LinearLayout>
