<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    tools:context=".TopTalentActivity">

    <!-- Header with title and filter -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D32F2F"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top Talents"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unknown ⌄"
            android:textColor="@android:color/white"
            android:layout_alignParentEnd="true"
            android:textSize="16sp"/>
    </RelativeLayout>

    <!-- New Tab Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#C73A3A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Tab Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/rounded_tab_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

            <!-- Daily Tab (Selected) -->
            <TextView
                android:id="@+id/tab_daily"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tab_selected"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Daily"
                android:textColor="#C62828"
                android:textSize="14sp" />

            <!-- 7 Days Tab -->
            <TextView
                android:id="@+id/tab_7_days"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="7 days"
                android:textColor="#FFF"
                android:textSize="14sp" />

            <!-- 30 Days Tab -->
            <TextView
                android:id="@+id/tab_30_days"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="30 days"
                android:textColor="#FFF"
                android:textSize="14sp" />

            <!-- Total Tab -->
            <TextView
                android:id="@+id/tab_total"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Total"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>


    <!-- Top 3 Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center"
        android:background="#EF5350">

        <!-- 3 Users -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/img_10"
                android:background="@drawable/circle_background"
                android:scaleType="centerCrop" />

            <TextView
                android:text="Baaz12"
                android:textColor="#FFF"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="💰 370.0K"
                android:textColor="#FFEB3B"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- Center user (taller) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/img_10"
                android:background="@drawable/circle_background"
                android:scaleType="centerCrop" />

            <TextView
                android:text="Baaz12"
                android:textColor="#FFF"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="💰 370.0K"
                android:textColor="#FFEB3B"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- 3rd User -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/img_10"
                android:background="@drawable/circle_background"
                android:scaleType="centerCrop" />

            <TextView
                android:text="Baaz12"
                android:textColor="#FFF"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="💰 370.0K"
                android:textColor="#FFEB3B"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </LinearLayout>

    <!-- RecyclerView for List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"/>
</LinearLayout>
